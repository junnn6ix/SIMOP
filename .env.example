# ==============================================================================
# SIMOP DPMPTSP - Environment Variables Example
# Duplicate this file to .env.local for local development.
# ==============================================================================

# Database (Neon PostgreSQL connection string, pooled)
DATABASE_URL="postgresql://user:password@ep-xyz.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# Test Database (Separate Neon branch or test database)
DATABASE_URL_TEST="postgresql://user:password@ep-xyz.ap-southeast-1.aws.neon.tech/neondb_test?sslmode=require"

# Better Auth Configuration
BETTER_AUTH_SECRET="a-very-long-random-secret-key-at-least-32-characters"
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional: Vercel & Preview Origin Configuration (Strict trustedOrigins)
VERCEL_PROJECT_PRODUCTION_URL=""
SIMOP_PREVIEW_DOMAIN=""

# Optional: Database Seeder Initial Passwords (Leave blank for random generation)
SEED_ADMIN_PASSWORD=""
SEED_PEGAWAI_PASSWORD=""

# E2E / Playwright Test Credentials (uses DATABASE_URL_TEST)
E2E_ADMIN_USERNAME="admin"
E2E_ADMIN_PASSWORD=""
E2E_PEGAWAI_USERNAME="pegawai_ptsp"
E2E_PEGAWAI_PASSWORD=""

# Cloudflare R2 Object Storage (S3-compatible)
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET_NAME="simop-dpmptsp-storage"
R2_PUBLIC_DOMAIN=""

# WhatsApp Gateway (Fonnte API - https://api.fonnte.com/send)
# Opsional untuk dev (default dry-run jika kosong atau jika bot belum aktif di pengaturan)
FONNTE_TOKEN="your-fonnte-api-device-token"

# Cron Job Authorization Secret (Bearer token untuk GET /api/cron/pbg-reminder)
# Wajib diisi pada lingkungan production demi keamanan fail-closed
CRON_SECRET="your-cron-secret-bearer-token"

# Environment
NODE_ENV="development"
